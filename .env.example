# IP LAN của máy chạy docker (dùng cho URL QR). Chạy `make ip` để tự detect.
LAN_IP=192.168.1.10

WEB_PORT=5173
API_PORT=3001
SOCKET_PORT=4000
DB_PORT=5433

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_development

REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev_jwt_secret_change_me
SOCKET_JWT_SECRET=dev_socket_secret_change_me

TZ=Asia/Ho_Chi_Minh

# Thông tin in trên hoá đơn (SPEC §5.4)
RESTAURANT_NAME=Nhà hàng Demo
RESTAURANT_ADDRESS=123 Lê Lợi, Q.1, TP.HCM
RESTAURANT_PHONE=0909 123 456
RESTAURANT_BILL_FOOTER=Cảm ơn quý khách, hẹn gặp lại!

# Đặt bàn (SPEC §5.5): chặn đặt trùng trong N phút; giữ chỗ trên sơ đồ trước giờ đến N phút
RESERVATION_DURATION_MINUTES=120
RESERVATION_HOLD_MINUTES=60

# Khuyến mãi (SPEC §5.6): phục vụ được giảm tay tối đa N% tổng bàn
MANUAL_DISCOUNT_MAX_PERCENT=10

# S3 (local: RustFS giả lập S3; production: AWS S3 → bỏ S3_ENDPOINT)
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin123
S3_BUCKET=restaurant-dev
S3_REGION=ap-southeast-1
S3_CONSOLE_PORT=9001
