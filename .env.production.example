# Production — copy thành .env.production (KHÔNG commit), điền giá trị thật.
# Dùng với: make prod-up  (docker-compose.prod.yml)

# Domain thật để in QR, ví dụ https://order.nhahang.vn
# Bỏ trống → QR dùng http://LAN_IP:WEB_PORT (chạy prod trong mạng LAN của quán)
PUBLIC_URL=
LAN_IP=192.168.1.10
WEB_PORT=80

# true khi chạy sau HTTPS (Cloudflare Tunnel / reverse proxy có SSL)
FORCE_SSL=false

# Sinh bằng: openssl rand -hex 64
SECRET_KEY_BASE=
JWT_SECRET=
SOCKET_JWT_SECRET=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=restaurant_production

TZ=Asia/Ho_Chi_Minh

# Thông tin in trên hoá đơn (SPEC §5.4)
RESTAURANT_NAME=Tên quán
RESTAURANT_ADDRESS=
RESTAURANT_PHONE=
RESTAURANT_BILL_FOOTER=Cảm ơn quý khách, hẹn gặp lại!

# --- Lưu ảnh: chọn 1 trong 2 ---
# Cloudflare R2:
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
# AWS S3: bỏ trống S3_ENDPOINT, S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=restaurant-prod
